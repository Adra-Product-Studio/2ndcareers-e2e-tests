# Copy to .env.test (git-ignored) and fill in real values for local runs.
# In CI these are supplied as GitHub Actions secrets instead - see
# ../.github/workflows/e2e-tests.yml in the main frontend repo.

# Staging/QA environment the tests run against.
PLAYWRIGHT_BASE_URL=https://staging.example.2ndcareers.com

# One test account per role. Leave a role blank to skip its "logs in successfully" step -
# the page-load / validation / invalid-credential steps still run either way.
PROFESSIONAL_TEST_EMAIL=
PROFESSIONAL_TEST_PASSWORD=

EMPLOYER_TEST_EMAIL=
EMPLOYER_TEST_PASSWORD=

PARTNER_TEST_EMAIL=
PARTNER_TEST_PASSWORD=

SUPERADMIN_TEST_EMAIL=
SUPERADMIN_TEST_PASSWORD=

# Optional - override the expected post-login redirect path per role.
# PROFESSIONAL_TEST_REDIRECT_PATH=/professional/home
# EMPLOYER_TEST_REDIRECT_PATH=/employer/home
# PARTNER_TEST_REDIRECT_PATH=/partner/home

# Watch the run live (headed browser + slow-motion actions):
#   npm run test:e2e:headed
# Interactive UI mode (step through each action, see before/after DOM):
#   npm run test:e2e:ui
